{
  "info": {
    "name": "ALMOX//CTRL API",
    "description": "Coleção de testes da API de controle de estoque.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('accessToken', json.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.com.br\",\n  \"senha\": \"SUA_SENHA\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh-token" }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/products?page=1&limit=20"
          }
        },
        {
          "name": "Criar produto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"PNEU-295\",\n  \"nome\": \"Pneu 295/80 R22.5\",\n  \"categoria\": \"FR\",\n  \"unidade\": \"un\",\n  \"estoqueMinimo\": 8,\n  \"estoqueAtual\": 5\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Estoque baixo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/products/estoque-baixo"
          }
        },
        {
          "name": "Importar CSV",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{baseUrl}}/products/import-csv"
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Listar veículos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/vehicles"
          }
        },
        {
          "name": "Criar veículo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1234\",\n  \"modelo\": \"Volvo FH 540\",\n  \"marca\": \"Volvo\"\n}"
            },
            "url": "{{baseUrl}}/vehicles"
          }
        }
      ]
    },
    {
      "name": "Movements",
      "item": [
        {
          "name": "Listar movimentações",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/movements"
          }
        },
        {
          "name": "Registrar movimentação (saída)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"type\": \"saida\",\n  \"quantidade\": 2,\n  \"referencia\": \"ABC-1234\",\n  \"vehiclePlaca\": \"ABC-1234\"\n}"
            },
            "url": "{{baseUrl}}/movements"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Consumo por veículo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/reports/consumo-veiculo?placa=ABC-1234"
          }
        },
        {
          "name": "Consumo por categoria",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/reports/consumo-categoria"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/dashboard/stats"
          }
        }
      ]
    }
  ]
}
